# MongoDB connection string (Atlas recommended for production)
DATABASE_URL=mongodb://127.0.0.1:27017/kai_portfolio

# Render sets PORT automatically; use 3000 for local development
PORT=3000
NODE_ENV=development

# Frontend URL for CORS (your Vercel deployment URL)
CLIENT_URL=https://your-portfolio.vercel.app

# Optional: protect admin/read routes in Postman
API_KEY=

# Gmail SMTP (use a 16-character App Password, not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM_NAME=Portfolio Website
EMAIL_FROM=Portfolio Website <your-gmail@gmail.com>
EMAIL_TO=your-gmail@gmail.com
