{
  "info": {
    "name": "KAI Portfolio API",
    "_postman_id": "8e6f3d47-5b9a-4c8b-a0e8-e735f3f8c1d5",
    "description": "Combined Postman collection for portfolio and contact API endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Portfolio",
      "item": [
        {
          "name": "GET All Projects",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/portfolio",
              "host": ["{{baseUrl}}"],
              "path": ["api", "portfolio"]
            }
          }
        },
        {
          "name": "GET Project by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/portfolio/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "portfolio", "{{projectId}}"]
            }
          }
        },
        {
          "name": "POST Create Project",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"New Project\",\n  \"description\": \"A portfolio project description.\",\n  \"imageUrl\": \"https://example.com/image.png\",\n  \"liveUrl\": \"https://example.com\",\n  \"githubUrl\": \"https://github.com/username/repo\",\n  \"technologies\": [\"React\", \"Node.js\"],\n  \"tags\": [\"web\", \"portfolio\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/portfolio",
              "host": ["{{baseUrl}}"],
              "path": ["api", "portfolio"]
            }
          }
        },
        {
          "name": "PUT Update Project",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Project Title\",\n  \"description\": \"Updated description.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/portfolio/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "portfolio", "{{projectId}}"]
            }
          }
        },
        {
          "name": "DELETE Project",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/portfolio/{{projectId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "portfolio", "{{projectId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Contact",
      "item": [
        {
          "name": "POST Send Contact Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kai\",\n  \"email\": \"kai@example.com\",\n  \"subject\": \"Hello from the portfolio\",\n  \"message\": \"This is a test message from the contact form.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/contact",
              "host": ["{{baseUrl}}"],
              "path": ["api", "contact"]
            }
          }
        },
        {
          "name": "GET Contact Messages",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/contact/messages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "contact", "messages"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "projectId",
      "value": "<projectId>"
    },
    {
      "key": "apiKey",
      "value": "api_7f3c9a1b8d2e4f6c9a0b5d7e1f3c8a9d"
    }
  ]
}
